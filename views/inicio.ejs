
<%- include('partials/header') %>

<main class="page-container my-5">

    <!-- PORTADA PRINCIPAL -->

    <section class="hero mb-5">

        <div class="row align-items-center">

            <div class="col-lg-8 hero-content">

                <span class="hero-tag">
                    ✨ PLATAFORMA DE SOPORTE ESTUDIANTIL
                </span>

                <h1 class="mb-4">
                    ¡Bienvenido a <br>
                    HelpDesk!
                </h1>

                <h2 class="h5 fw-bold mb-3">
                    Sistema de Gestión de Soporte Técnico
                </h2>

                <p class="hero-description mb-4">
                    ¿Tienes problemas con los equipos tecnológicos
                    de la institución? Estamos aquí para ayudarte.

                    Reporta cualquier inconveniente con computadores,
                    proyectores, conexiones y otros recursos tecnológicos.
                </p>

                <a href="/reportar" class="btn btn-helpdesk btn-lg">
                    Reportar una falla &nbsp; →
                </a>

            </div>

            <div class="col-lg-4 hero-illustration">

                <span class="hero-decoration decoration-one">✦</span>

                <div class="illustration-circle">
                    💻
                </div>

                <span class="hero-decoration decoration-two">♡</span>

            </div>

        </div>

    </section>


    <!-- SECCIÓN INFORMATIVA -->

    <div class="text-center mb-4">

        <span class="hero-tag">
            ¿CÓMO FUNCIONA?
        </span>

        <h2 class="fw-bold mt-2" style="color: #563477;">
            Tu soporte en tres pasos
        </h2>

        <p class="section-subtitle">
            Una forma fácil y organizada de solucionar problemas tecnológicos.
        </p>

    </div>


    <div class="row g-4">

        <!-- TARJETA 1 -->

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon icon-purple">
                    📝
                </div>

                <h3>01. Reporta</h3>

                <p>
                    Registra los problemas técnicos que encuentres
                    en los equipos o espacios de la institución.
                </p>

            </div>

        </div>


        <!-- TARJETA 2 -->

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon icon-pink">
                    🔍
                </div>

                <h3>02. Consulta</h3>

                <p>
                    El personal encargado puede revisar los
                    reportes registrados y conocer los problemas pendientes.
                </p>

            </div>

        </div>


        <!-- TARJETA 3 -->

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon icon-blue">
                    💜
                </div>

                <h3>03. Soluciona</h3>

                <p>
                    Una vez atendido el inconveniente, el ticket
                    puede marcarse como resuelto y desaparecer del panel.
                </p>

            </div>

        </div>

    </div>

</main>

<%- include('partials/footer') %>
